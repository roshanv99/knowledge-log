# All optional except KL_RUNNER_TOKEN; defaults shown.
# The runner's token for /api/pipeline/* (cd backend && uv run manage.py runner_token kl@<host>).
KL_RUNNER_TOKEN=
# KL_API_BASE=http://localhost:8010/api
# KL_NOTES_DIR=~/Documents/Notes
# KL_OUTPUT_DIR=./output
# KL_WORK_DIR=./.kl
# KL_CLAUDE_BIN=claude
# KL_QUESTIONS_PER_CHUNK=3
# KL_MAX_REVISIONS=2
# KL_PAGE_DPI=130
# Planner (backend): pages per chunk, and seconds a claim lasts without a heartbeat.
# KL_CHUNK_PAGES=4
# KL_LEASE_SECONDS=600
