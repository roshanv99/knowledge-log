# Copy to deploy/oauth2-proxy.env (gitignored) on the server and fill in.
# Client ID/secret and redirect URI come from the Google OAuth client (Google Cloud Console
# → APIs & Services → Credentials → OAuth client ID → Web application).
# Cookie secret: `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`

OAUTH2_PROXY_PROVIDER=google
# Restrict to your own account only — a single personal app, not a shared one like log-book.
# oauth2-proxy has no single-email allowlist flag; a domain of exactly your Google account's
# domain (e.g. gmail.com) is as tight as it gets without switching to authenticated_emails_file.
OAUTH2_PROXY_EMAIL_DOMAINS=
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://kl.example.com/oauth2/callback
