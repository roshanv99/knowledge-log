# Copy to repo root as `.env` on the server (deploy/HOSTINGER.md). This is the same .env
# config/settings.py and infra/docker-compose.yml already read locally — on the server it
# also carries the production/R2 settings below.
#
# Generate DJANGO_SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Public site ---
DOMAIN=kl.example.com

# --- Django ---
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=kl.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kl.example.com
# Only needed if the web app is ever served from a different origin than the API (it isn't,
# in this deploy shape — nginx puts both behind one domain).
CORS_ORIGINS=

# --- Postgres ---
POSTGRES_DB=knowledge_log
POSTGRES_USER=kl
POSTGRES_PASSWORD=change_me

# --- Media (reels) ---
KL_MAX_MEDIA_BYTES=209715200
STORAGE_BACKEND=r2
R2_BUCKET=knowledge-log-media
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public R2.dev subdomain or a custom domain mapped to the bucket. Leave blank to keep the
# bucket private and serve presigned URLs instead (see backend/config/storage.py).
R2_PUBLIC_BASE_URL=

# --- Google OAuth (oauth2-proxy) ---
# Not read from this file — oauth2-proxy has its own env_file, deploy/oauth2-proxy.env
# (copy from deploy/oauth2-proxy.env.example). Kept separate so rotating the OAuth secret
# never touches Django's env.

# --- Runner (issued via `manage.py runner_token`, kept out of git) ---
# KL_RUNNER_TOKEN=
